# Neon: pooled (-pooler host) for the app, direct for migrations and the worker
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. Secret: min 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend. Sender on a domain verified in Resend, e.g. ReelPilot <hello@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Optional: "console" prints emails (magic links) to the server log instead
# of sending them, for a local stack without a mail account
# EMAIL_TRANSPORT=resend

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_TOPUP_5=

# AI text via the Vercel AI SDK. Provider name (e.g. anthropic), model id,
# and that provider's own key variable
AI_TEXT_PROVIDER=
AI_TEXT_MODEL=
ANTHROPIC_API_KEY=
# Optional: "off" stops the worker describing key moments with AI vision
AI_VISION=on
# Optional: "on" gives translations and posting kits stand-in words instead
# of asking the model (development/CI only)
# AI_TEXT_TEST=off

# Optional: voiceover. Unset = off. "openai" or "elevenlabs" need the model,
# a voice id and that provider's key; "test" is a tone (development/CI only).
# VOICE_PROVIDER=
# VOICE_MODEL=
# VOICE_ID=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# Optional: pictures for recipes. Unset = off. "openai" needs IMAGE_MODEL and
# OPENAI_API_KEY; "test" draws a placeholder PNG (development/CI only).
# IMAGE_PROVIDER=
# IMAGE_MODEL=

# Neon Object Storage (from M1). Don't fill by hand: `neon env pull` writes these
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Set by `neon env pull`; the live storage test runs only when it's present
NEON_BRANCH=
# CI only: set to 1 to run storage tests against a local S3 server
# STORAGE_TESTS=

# Optional: export renderer, "hyperframes" (default) or "remotion"
# RENDER_ENGINE=hyperframes
# Optional: HyperFrames capture workers, a number or "auto" (default 1;
# "auto" dropped frames on a GPU machine)
# RENDER_WORKERS=1

# Optional: Remotion company licence key, used when RENDER_ENGINE=remotion
# REMOTION_LICENSE_KEY=

SENTRY_DSN=
NEXT_PUBLIC_APP_URL=
