# CI placeholders, on ports that avoid other local services (55432 Postgres, 18333 S3, app 3200).
E2E_PORT=3200
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/reelpilot
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:55432/reelpilot
BETTER_AUTH_SECRET=ci-only-4f9c2a7e1b8d3c6f0a5e9b2d7c1f4a8e
BETTER_AUTH_URL=http://localhost:3200
GOOGLE_CLIENT_ID=ci
GOOGLE_CLIENT_SECRET=ci
GITHUB_CLIENT_ID=ci
GITHUB_CLIENT_SECRET=ci
RESEND_API_KEY=re_ci
EMAIL_FROM="ReelPilot <ci@example.com>"
AI_TEXT_PROVIDER=anthropic
AI_TEXT_MODEL=ci
ANTHROPIC_API_KEY=sk-ant-ci
AI_VISION=off
AWS_ACCESS_KEY_ID=ci-access
AWS_SECRET_ACCESS_KEY=ci-secret-key
AWS_ENDPOINT_URL_S3=http://localhost:18333
AWS_REGION=us-east-1
STORAGE_TESTS=1
NEXT_PUBLIC_APP_URL=http://localhost:3200
VOICE_PROVIDER=test
# Recipe pictures: a placeholder PNG (no provider account).
IMAGE_PROVIDER=test
