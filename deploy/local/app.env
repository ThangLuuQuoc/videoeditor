# The local stack's settings (deploy/local/compose.yml). Local-only values:
# nothing here is a real account. Put real keys in secrets.env (ignored by git).
DATABASE_URL=postgresql://postgres:postgres@db:5432/reelpilot
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@db:5432/reelpilot
BETTER_AUTH_SECRET=local-only-5b2e8f1c9d4a7e3b6c0f2a8d1e9b4c7a
BETTER_AUTH_URL=http://localhost:3300
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Google/GitHub sign-in need real OAuth apps; use the magic link instead:
# it prints to `docker compose -f deploy/local/compose.yml logs app`.
GOOGLE_CLIENT_ID=local
GOOGLE_CLIENT_SECRET=local
GITHUB_CLIENT_ID=local
GITHUB_CLIENT_SECRET=local
RESEND_API_KEY=re_local
EMAIL_FROM=ReelPilot <local@example.com>
EMAIL_TRANSPORT=console

# AI (brand kit drafts, AI director, scripts): set a real ANTHROPIC_API_KEY
# and AI_TEXT_MODEL in secrets.env to use them; without one they say so.
AI_TEXT_PROVIDER=anthropic
AI_TEXT_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-local
AI_VISION=off

# SeaweedFS from compose.yml, reached the same way by the browser and the
# containers. Credentials from .github/s3-ci.json.
AWS_ACCESS_KEY_ID=ci-access
AWS_SECRET_ACCESS_KEY=ci-secret-key
AWS_ENDPOINT_URL_S3=http://host.docker.internal:18340
AWS_REGION=us-east-1

# Voiceover with the test tone (no provider account).
VOICE_PROVIDER=test
# Recipe pictures: a placeholder PNG (no provider account).
IMAGE_PROVIDER=test
