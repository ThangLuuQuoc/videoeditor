# Placeholders for `next build` inside the Dockerfile only: the build checks
# that every variable is set, but never contacts these services. The real
# values are given to the running containers (deploy/local/app.env).
DATABASE_URL=postgresql://build:build@localhost:5432/build
DATABASE_URL_UNPOOLED=postgresql://build:build@localhost:5432/build
BETTER_AUTH_SECRET=build-only-0000000000000000000000000000
BETTER_AUTH_URL=http://localhost:3300
GOOGLE_CLIENT_ID=build
GOOGLE_CLIENT_SECRET=build
GITHUB_CLIENT_ID=build
GITHUB_CLIENT_SECRET=build
RESEND_API_KEY=re_build
EMAIL_FROM="ReelPilot <build@example.com>"
AI_TEXT_PROVIDER=anthropic
AI_TEXT_MODEL=build
ANTHROPIC_API_KEY=sk-ant-build
AWS_ACCESS_KEY_ID=build
AWS_SECRET_ACCESS_KEY=build
AWS_ENDPOINT_URL_S3=http://localhost:18340
AWS_REGION=us-east-1
